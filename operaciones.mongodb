// Mostrar todos los productos en la colección
db.productos.find();

//  Mostrar solo los productos que sean de tipo Laptop
db.productos.find(
  { "categoria.nombre_categoria": "Laptops" }
);

//  Mostrar los productos con más de 10 unidades en stock y un precio menor a 1000
db.productos.find(
  { stock: { $gt: 10 }, precio: { $lt: 1000 } }
);
//   Mostrar solo el nombre, precio y stock de los "Smartphone"
db.productos.find(
  { "categoria.nombre_categoria": "Smartphones" },
  { nombre: 1, precio: 1, stock: 1, _id: 0 }
);

//   Mostrar solo el nombre, precio y stock de los "Smartphone"
db.productos.find(
  { "categoria.nombre_categoria": "Smartphones" },
  { nombre: 1, precio: 1, stock: 1, _id: 0 }
);

// Buscar un Smartphone por nombre o categoría y reducir su stock en 1 unidad
db.productos.updateOne(
  { "categoria.nombre_categoria": "Smartphones" },
  { $inc: { stock: -1 } }
);
// Actualizar su precio y añadir el campo 'ultima_revision' con la fecha actual
db.productos.updateOne(
  { "categoria.nombre_categoria": "Laptops" },
  { 
    $set: { 
      precio: 950, 
      ultima_revision: new Date() 
    } 
  }
);